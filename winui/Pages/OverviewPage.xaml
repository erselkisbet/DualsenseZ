<Page x:Class="DualsenseZNative.OverviewPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" SizeChanged="LayoutChanged">
 <Page.Resources>
  <Storyboard x:Key="ControllerFadeIn"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.8"/></Storyboard>
  <Style x:Key="DashboardCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="20"/><Setter Property="CornerRadius" Value="12"/></Style>
  <Style x:Key="Shortcut" TargetType="Button"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="16"/><Setter Property="MinHeight" Value="84"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/></Style>
  <Style x:Key="Segment" TargetType="ToggleButton"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Padding" Value="4,12"/><Setter Property="MinWidth" Value="0"/><Setter Property="CornerRadius" Value="8"/></Style>
 </Page.Resources>
 <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
  <StackPanel Spacing="16" Margin="0,0,20,0" HorizontalAlignment="Stretch">
   <Grid x:Name="PageHeader"><TextBlock Text="@Overview@" Style="{ThemeResource TitleTextBlockStyle}"/>
    <ComboBox x:Name="ControllerSelector" AutomationProperties.Name="@WinUI.SelectedController@" SelectionChanged="SelectController" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
       <ComboBoxItem Content="@WinUI.Controller1@"/><ComboBoxItem Content="@WinUI.Controller2@"/><ComboBoxItem Content="@WinUI.Controller3@"/><ComboBoxItem Content="@WinUI.Controller4@"/>
      </ComboBox>
   </Grid>
   <Grid x:Name="Dashboard" ColumnSpacing="16" RowSpacing="16">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="ControllerColumn" Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="ControllerPanel" Style="{StaticResource DashboardCard}" VerticalAlignment="Stretch">
     <StackPanel Spacing="16">
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Spacing="4"><TextBlock Text="@WinUI.CurrentProfile@" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="Profile" Text="@CurrentSettings@" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
       <FontIcon Grid.Column="1" Glyph="&#xE8A5;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </Grid>

      <StackPanel Spacing="8">
       <TextBlock x:Name="DeviceName" Text="@WinUI.NoControllerConnected@" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <Grid ColumnSpacing="16" Margin="0,0,0,24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><FontIcon x:Name="ConnectionIcon" Glyph="&#xE8EA;" FontSize="14" VerticalAlignment="Center"/><TextBlock x:Name="Connection" Text="@Disconnected@" TextWrapping="NoWrap" VerticalAlignment="Center"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><FontIcon x:Name="BatteryIcon" Glyph="&#xE83F;" FontSize="14" VerticalAlignment="Center"/><TextBlock x:Name="BatteryStatus" Text="—" TextWrapping="NoWrap" VerticalAlignment="Center"/></StackPanel>
       </Grid>
      </StackPanel>
      <Grid Height="220" IsHitTestVisible="False">
       <Grid.ColumnDefinitions><ColumnDefinition Width="7.5*"/><ColumnDefinition Width="85*"/><ColumnDefinition Width="7.5*"/></Grid.ColumnDefinitions>
       <Image Grid.Column="1" Source="ms-appx:///Assets/dsai.png" Stretch="Uniform" MaxHeight="187" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
       <Image x:Name="ConnectedPreview" Grid.Column="1" Source="ms-appx:///Assets/dsimg.png" Stretch="Uniform" MaxHeight="187" HorizontalAlignment="Stretch" VerticalAlignment="Center" Opacity="0"/>
      </Grid>
      <StackPanel Spacing="8"><TextBlock Text="@WinUI.EmulationMode@" FontWeight="SemiBold"/>
       <Grid x:Name="Emulation" ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <ToggleButton x:Name="EmulationNone" IsEnabled="False" Style="{StaticResource Segment}" Tag="0" Click="SelectEmulation" AutomationProperties.Name="@None@"><StackPanel Spacing="6"><FontIcon Glyph="&#xE711;" FontSize="18"/><TextBlock Text="@None@" FontSize="12" HorizontalAlignment="Center"/></StackPanel></ToggleButton>
        <ToggleButton x:Name="EmulationXbox" IsEnabled="False" Grid.Column="1" Style="{StaticResource Segment}" Tag="1" Click="SelectEmulation" AutomationProperties.Name="Xbox 360">
         <ToggleButton.Resources><SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#107C10"/><SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#138A13"/><SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#0B650B"/><SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#107C10"/><SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#138A13"/><SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#0B650B"/><SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="White"/><SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="White"/><SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="White"/></ToggleButton.Resources>
         <StackPanel Spacing="6"><Viewbox Width="20" Height="20" Stretch="Uniform"><Canvas Width="88" Height="88"><Path Data="M39.73 86.91c-6.628-.635-13.338-3.015-19.102-6.776-4.83-3.15-5.92-4.447-5.92-7.032 0-5.193 5.71-14.29 15.48-24.658 5.547-5.89 13.275-12.79 14.11-12.604 1.626.363 14.616 13.034 19.48 19 7.69 9.43 11.224 17.154 9.428 20.597-1.365 2.617-9.837 7.733-16.06 9.698-5.13 1.62-11.867 2.306-17.416 1.775zM8.184 67.703c-4.014-6.158-6.042-12.22-7.02-20.988-.324-2.895-.21-4.55.733-10.494 1.173-7.4 5.39-15.97 10.46-21.24 2.158-2.24 2.35-2.3 4.982-1.41 3.19 1.08 6.6 3.436 11.89 8.22l3.09 2.794-1.69 2.07c-7.828 9.61-16.09 23.24-19.2 31.67-1.69 4.58-2.37 9.18-1.64 11.095.49 1.294.04.812-1.61-1.714zm70.453 1.047c.397-1.936-.105-5.49-1.28-9.076-2.545-7.765-11.054-22.21-18.867-32.032l-2.46-3.092 2.662-2.443c3.474-3.19 5.886-5.1 8.49-6.723 2.053-1.28 4.988-2.413 6.25-2.413.777 0 3.516 2.85 5.726 5.95 3.424 4.8 5.942 10.63 7.218 16.69.825 3.92.894 12.3.133 16.21-.63 3.208-1.95 7.366-3.23 10.187-.97 2.113-3.36 6.218-4.41 7.554-.54.687-.54.686-.24-.796zM40.44 11.505C36.834 9.675 31.272 7.71 28.2 7.18c-1.076-.185-2.913-.29-4.08-.23-2.536.128-2.423-.004 1.643-1.925 3.38-1.597 6.2-2.536 10.03-3.34C40.098.78 48.193.77 52.43 1.663c4.575.965 9.964 2.97 13 4.84l.904.554-2.07-.104C60.148 6.745 54.15 8.408 47.71 11.54c-1.942.946-3.63 1.7-3.754 1.68-.123-.024-1.706-.795-3.52-1.715z" Fill="{Binding Foreground, ElementName=EmulationXbox}"/></Canvas></Viewbox><TextBlock Text="Xbox 360" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="EmulationDS4" IsEnabled="False" Grid.Column="2" Style="{StaticResource Segment}" Tag="2" Click="SelectEmulation" AutomationProperties.Name="DualShock 4">
         <ToggleButton.Resources><SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#003791"/><SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#0A48AD"/><SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#002B73"/><SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#003791"/><SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#0A48AD"/><SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#002B73"/><SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="White"/><SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="White"/><SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="White"/></ToggleButton.Resources>
         <StackPanel Spacing="6"><Viewbox Width="20" Height="20" Stretch="Uniform"><Canvas Width="200" Height="154.8"><Path Data="M197.2,118c-3.9,4.9-13.3,8.4-13.3,8.4l-70.5,25.3v-18.7l51.9-18.5c5.9-2.1,6.8-5.1,2-6.7-4.8-1.6-13.4-1.1-19.3,1l-34.6,12.2v-19.4l2-.7s10-3.5,24-5.1c14-1.5,31.2.2,44.7,5.3,15.2,4.8,16.9,11.9,13.1,16.8ZM120.1,86.2v-47.8c0-5.6-1-10.8-6.3-12.2-4-1.3-6.5,2.5-6.5,8.1v119.6l-32.3-10.2V1c13.7,2.5,33.7,8.6,44.4,12.2,27.3,9.4,36.6,21,36.6,47.3s-15.8,35.3-35.9,25.6ZM15.9,131C.2,126.6-2.4,117.5,4.8,112.2c6.6-4.9,17.8-8.5,17.8-8.5l46.2-16.4v18.7l-33.3,11.9c-5.9,2.1-6.8,5.1-2,6.7,4.8,1.6,13.4,1.1,19.3-1l16-5.8v16.8c-1,.2-2.1.4-3.2.5-16,2.6-33,1.5-49.7-4h0Z" Fill="{Binding Foreground, ElementName=EmulationDS4}"/></Canvas></Viewbox><TextBlock Text="DualShock 4" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
        </ToggleButton>
       </Grid>
       <TextBlock x:Name="EmulationStatus" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
      </StackPanel>
     </StackPanel>
    </Border>
    <Grid x:Name="MainDashboard" Grid.Column="1" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Style="{StaticResource DashboardCard}" Padding="16">
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Width="44" Height="44" CornerRadius="22" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><FontIcon x:Name="StatusIcon" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE7FC;" FontSize="22"/></Border>
       <StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Name="ActiveDevice" Text="@WinUI.NoControllerConnected@" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ActiveDetails" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
      </Grid>
     </Border>
     <!-- Brand hero: always deep blue with light text, independent of the app theme. -->
     <Border Grid.Row="1" CornerRadius="12" MinHeight="224" BorderThickness="1" BorderBrush="#2EFFFFFF" RequestedTheme="Dark">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0B4FC0" Offset="0"/><GradientStop Color="#003791" Offset="0.5"/><GradientStop Color="#00102E" Offset="1"/></LinearGradientBrush></Border.Background>
      <Grid>
       <Rectangle RadiusX="12" RadiusY="12" IsHitTestVisible="False"><Rectangle.Fill><RadialGradientBrush Center="0.9,0.1" GradientOrigin="0.9,0.1" RadiusX="0.75" RadiusY="1"><GradientStop Color="#664F8DFF" Offset="0"/><GradientStop Color="#004F8DFF" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
       <Path Data="M0,170 C90,60 190,210 300,40" Stroke="#30FFFFFF" StrokeThickness="1" Stretch="Fill" Margin="0,36,0,28" IsHitTestVisible="False"/>
       <Path Data="M0,60 C110,150 200,20 300,130" Stroke="#1CFFFFFF" StrokeThickness="1" Stretch="Fill" Margin="0,48,0,40" IsHitTestVisible="False"/>
       <Image Source="ms-appx:///Assets/TitleBarLogo.png" Height="210" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-34,0" Opacity="0.13" IsHitTestVisible="False"/>
       <StackPanel Spacing="12" Margin="28,24" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="12"><Image Source="ms-appx:///Assets/TitleBarLogo.png" Height="40" VerticalAlignment="Center"/><TextBlock Text="DualsenseZ" FontSize="32" FontWeight="Light" CharacterSpacing="30" Foreground="White" VerticalAlignment="Center"/></StackPanel>
        <Border Width="44" Height="2" CornerRadius="1" HorizontalAlignment="Left"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
        <TextBlock Text="@WinUI.YourControllerAndItsCurrentConfiguration@" FontSize="16" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left" Foreground="White"/>
        <TextBlock x:Name="HeroStatus" Text="@WinUI.ConnectYourDualSenseOrDualShock4UsingUSBOrBluetooth@" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left" Foreground="#BFFFFFFF"/>
       </StackPanel>
      </Grid>
     </Border>
     <Grid Grid.Row="2" ColumnSpacing="8" RowSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource Shortcut}" Tag="Profiles" Click="OpenPage"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8F1;" FontSize="20"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="@WinUI.Profiles@" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="@WinUI.ProfilesNavigationDescription@" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"/></Grid></Button>
      <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource Shortcut}" Tag="Controller" Click="OpenPage"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE7FC;" FontSize="20"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="@Controller@" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="@WinUI.ControllerNavigationDescription@" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"/></Grid></Button>
      <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource Shortcut}" Tag="Adaptive Triggers" Click="OpenPage"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xEC4A;" FontSize="20"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="@WinUI.AdaptiveTriggers@" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="L2 / R2" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"/></Grid></Button>
      <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource Shortcut}" Tag="Sound &amp; Haptics" Click="OpenPage"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE9E9;" FontSize="20"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="@WinUI.SoundHaptics@" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="@Audio passthrough@" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"/></Grid></Button>
      <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource Shortcut}" Tag="Lighting" Click="OpenPage"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xEA80;" FontSize="20"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="@Lighting@" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="@Lightbar@" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"/></Grid></Button>
      <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource Shortcut}" Tag="Motion &amp; Touch" Click="OpenPage"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE815;" FontSize="20"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="@WinUI.MotionTouch@" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="@WinUI.GyroMouse@" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"/></Grid></Button>
     </Grid>
    </Grid>
   </Grid>
  </StackPanel>
 </ScrollViewer>
</Page>





