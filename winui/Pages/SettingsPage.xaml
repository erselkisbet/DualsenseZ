 <StackPanel Spacing="10"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE946;" FontSize="18"/><TextBlock Text="@WinUI.AboutDualsenseZ@" FontSize="18" FontWeight="SemiBold"/></StackPanel><Border Style="{StaticResource SettingsCard}"><Grid x:Name="AboutLayout" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="56" Height="56" CornerRadius="12" VerticalAlignment="Top"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0B4FC0" Offset="0"/><GradientStop Color="#003791" Offset="1"/></LinearGradientBrush></Border.Background><Image Source="ms-appx:///Assets/TitleBarLogo.png" Width="34" Height="34" Stretch="Uniform"/></Border>
  <StackPanel Grid.Column="1" Spacing="12"><TextBlock Text="@WinUI.AboutTagline@" FontSize="18" TextWrapping="Wrap" MaxWidth="470" HorizontalAlignment="Left"/>
   <StackPanel Spacing="2"><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="@WinUI.DualsenseZOn@" FontSize="12" VerticalAlignment="Center"/><HyperlinkButton AutomationProperties.Name="@WinUI.DualsenseZOnGitHub@" NavigateUri="https://github.com/erselkisbet/DualsenseZ" Padding="0" MinHeight="0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="GitHub" FontSize="12"/><FontIcon Glyph="&#xE8A7;" FontSize="11"/></StackPanel></HyperlinkButton></StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="@WinUI.DevelopedBy@" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/><HyperlinkButton AutomationProperties.Name="ersel.art" NavigateUri="https://ersel.art" Padding="0" MinHeight="0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="ersel" FontSize="12"/><FontIcon Glyph="&#xE8A7;" FontSize="11"/></StackPanel></HyperlinkButton></StackPanel></StackPanel>
  </StackPanel></Grid>
 <Grid Grid.Column="1"><Border x:Name="AboutDivider" Width="1" HorizontalAlignment="Left" Background="{ThemeResource CardStrokeColorDefaultBrush}"/><StackPanel x:Name="VersionDetails" Margin="20,0,0,0" Spacing="6"><TextBlock Text="@WinUI.SettingsAppVersionLabel@" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock x:Name="AppVersion" FontWeight="SemiBold" VerticalAlignment="Center"/><Border x:Name="PrereleaseBadge" CornerRadius="4" Padding="6,1,6,2" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center"><TextBlock Text="BETA" FontSize="10" FontWeight="SemiBold" CharacterSpacing="60" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/></Border></StackPanel>
   <StackPanel Spacing="2" Margin="0,4,0,0"><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="@WinUI.BasedOn@" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="DualSenseY" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="WujekFoliarz" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/><HyperlinkButton AutomationProperties.Name="@WinUI.OriginalProjectOnGitHub@" NavigateUri="https://github.com/WujekFoliarz/DualSenseY-v2" Padding="0" MinHeight="0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="GitHub" FontSize="12"/><FontIcon Glyph="&#xE8A7;" FontSize="11"/></StackPanel></HyperlinkButton></StackPanel></StackPanel>
  </StackPanel></Grid>
 </Grid></Border></StackPanel>
 </StackPanel></Grid></ScrollViewer>
