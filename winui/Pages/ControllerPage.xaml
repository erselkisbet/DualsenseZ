<Page x:Class="DualsenseZNative.ControllerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Page.Resources>
  <Style x:Key="DashboardCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="20"/><Setter Property="CornerRadius" Value="12"/></Style>
  <DataTemplate x:Key="SwitchLabel"><Grid Visibility="Collapsed"/></DataTemplate>
  <Style x:Key="RowSwitch" TargetType="ToggleSwitch"><Setter Property="Width" Value="44"/><Setter Property="MinWidth" Value="44"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="OnContentTemplate" Value="{StaticResource SwitchLabel}"/><Setter Property="OffContentTemplate" Value="{StaticResource SwitchLabel}"/></Style>
 </Page.Resources>
 <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"><StackPanel Spacing="16" Margin="0,0,20,0" HorizontalAlignment="Stretch">
  <Grid x:Name="PageHeader"><StackPanel Spacing="6"><TextBlock Text="@Controller@" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock Text="@WinUI.ControllerDashboardDescription@" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><ComboBox x:Name="ControllerSelector" SelectionChanged="SelectController"/></Grid>
  <InfoBar x:Name="Empty" IsOpen="True" IsClosable="False" Title="@ConnectController@" Message="@WinUI.ConnectUsingUSBOrBluetoothToChangeControllerOptionsYourCurrentConfigurationIsShownBelow@"/>
  <InfoBar x:Name="DriverInfo" IsOpen="False" IsClosable="False" Severity="Warning" Title="@WinUI.VirtualControllerDriverUnavailable@"><HyperlinkButton Content="@WinUI.GetViGEmBus@" NavigateUri="https://github.com/nefarius/ViGEmBus/releases"/></InfoBar>
  <InfoBar x:Name="ModInfo" IsOpen="False" IsClosable="False" Title="@WinUI.AGameOrModIsControllingOutput2@" Message="@WinUI.LocalSettingsMayBeOverriddenWhileTheModIsActive@"/>
<Border x:Name="Shortcuts" Style="{StaticResource DashboardCard}"><StackPanel Spacing="16"><StackPanel Spacing="4"><TextBlock x:Name="ShortcutsTitle" Text="@WinUI.KeyboardShortcuts@" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/><TextBlock x:Name="ShortcutsDescription" Text="@WinUI.KeyboardShortcutsDescription@" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><StackPanel x:Name="BasicOptions" Spacing="16">
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="@WinUI.UseAnalogStickAsWASD@" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch x:Name="Wasd" Grid.Column="1" Style="{StaticResource RowSwitch}" AutomationProperties.Name="@WinUI.UseAnalogStickAsWASD@" Toggled="OptionChanged"/></Grid>
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="@WinUI.UsePSButtonAsWindowsKey@" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch x:Name="PsKey" Grid.Column="1" Style="{StaticResource RowSwitch}" AutomationProperties.Name="@WinUI.UsePSButtonAsWindowsKey@" Toggled="OptionChanged"/></Grid>
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="@WinUI.UseShareButtonAsSelect@" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch x:Name="Share" Grid.Column="1" Style="{StaticResource RowSwitch}" AutomationProperties.Name="@WinUI.UseShareButtonAsSelect@" Toggled="OptionChanged"/></Grid>
    </StackPanel></StackPanel></Border>
<Border x:Name="InputPanel" Style="{StaticResource DashboardCard}"><StackPanel Spacing="16">
  <StackPanel Spacing="6"><TextBlock Text="@WinUI.InputSettings@" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/><TextBlock Text="@WinUI.RawAxes0255CenterApproximately128DeadzonesAffectEmulatedOutput@" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
  <Grid x:Name="InputLayout" ColumnSpacing="20" RowSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Grid.Column="0" Spacing="16">
    <StackPanel Spacing="8"><TextBlock Text="@WinUI.LeftStickDeadzone0127@" TextWrapping="Wrap"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><NumberBox x:Name="LeftDeadzone" Minimum="0" Maximum="127" SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="DeadzoneChanged" AutomationProperties.Name="@WinUI.LeftStickDeadzone0127@"/><Slider x:Name="LeftDeadzoneSlider" Grid.Column="1" Minimum="0" Maximum="127" StepFrequency="1" ValueChanged="DeadzoneSliderChanged" VerticalAlignment="Center" AutomationProperties.Name="@WinUI.LeftStickDeadzone0127@"/></Grid></StackPanel>
    <StackPanel x:Name="LeftFeedback" Spacing="12">
     <TextBlock x:Name="LeftState" TextWrapping="Wrap"/>
     <ProgressBar x:Name="LeftX" Maximum="255" AutomationProperties.Name="@WinUI.LeftStickX@"/>
     <ProgressBar x:Name="LeftY" Maximum="255" AutomationProperties.Name="@WinUI.LeftStickY@"/>
     <StackPanel Spacing="4" Margin="0,8,0,0"><TextBlock Text="@WinUI.LeftStick@" HorizontalAlignment="Center"/><Viewbox Stretch="Uniform" MaxHeight="140"><Canvas Width="140" Height="140" IsHitTestVisible="False"><Ellipse Width="120" Height="120" Canvas.Left="10" Canvas.Top="10" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1"/><Ellipse Width="60" Height="60" Canvas.Left="40" Canvas.Top="40" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="1"/><Line X1="70" Y1="10" X2="70" Y2="130" Stroke="{ThemeResource CardStrokeColorDefaultBrush}"/><Line X1="10" Y1="70" X2="130" Y2="70" Stroke="{ThemeResource CardStrokeColorDefaultBrush}"/><Ellipse x:Name="LeftDot" Width="12" Height="12" Canvas.Left="64" Canvas.Top="64" Fill="{ThemeResource AccentFillColorDefaultBrush}"/></Canvas></Viewbox></StackPanel>
    </StackPanel>
   </StackPanel>
   <StackPanel Grid.Column="1" Spacing="16">
    <StackPanel Spacing="8"><TextBlock Text="@WinUI.RightStickDeadzone0127@" TextWrapping="Wrap"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><NumberBox x:Name="RightDeadzone" Minimum="0" Maximum="127" SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="DeadzoneChanged" AutomationProperties.Name="@WinUI.RightStickDeadzone0127@"/><Slider x:Name="RightDeadzoneSlider" Grid.Column="1" Minimum="0" Maximum="127" StepFrequency="1" ValueChanged="DeadzoneSliderChanged" VerticalAlignment="Center" AutomationProperties.Name="@WinUI.RightStickDeadzone0127@"/></Grid></StackPanel>
    <StackPanel x:Name="RightFeedback" Spacing="12">
     <TextBlock x:Name="RightState" TextWrapping="Wrap"/>
     <ProgressBar x:Name="RightX" Maximum="255" AutomationProperties.Name="@WinUI.RightStickX@"/>
     <ProgressBar x:Name="RightY" Maximum="255" AutomationProperties.Name="@WinUI.RightStickY@"/>
     <StackPanel Spacing="4" Margin="0,8,0,0"><TextBlock Text="@WinUI.RightStick@" HorizontalAlignment="Center"/><Viewbox Stretch="Uniform" MaxHeight="140"><Canvas Width="140" Height="140" IsHitTestVisible="False"><Ellipse Width="120" Height="120" Canvas.Left="10" Canvas.Top="10" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1"/><Ellipse Width="60" Height="60" Canvas.Left="40" Canvas.Top="40" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="1"/><Line X1="70" Y1="10" X2="70" Y2="130" Stroke="{ThemeResource CardStrokeColorDefaultBrush}"/><Line X1="10" Y1="70" X2="130" Y2="70" Stroke="{ThemeResource CardStrokeColorDefaultBrush}"/><Ellipse x:Name="RightDot" Width="12" Height="12" Canvas.Left="64" Canvas.Top="64" Fill="{ThemeResource AccentFillColorDefaultBrush}"/></Canvas></Viewbox></StackPanel>
    </StackPanel>
   </StackPanel>
  </Grid>
 </StackPanel></Border>
   <Border x:Name="VisibilityPanel" Style="{StaticResource DashboardCard}"><Grid x:Name="HideLayout" ColumnSpacing="20" RowSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Spacing="16">
    <TextBlock Text="@WinUI.PhysicalControllerVisibility@" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
    <TextBlock Text="@WinUI.ControllerVisibilityDescription@" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="@WinUI.HidePhysicalController@" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch x:Name="Hidden" Grid.Column="1" Style="{StaticResource RowSwitch}" AutomationProperties.Name="@WinUI.HidePhysicalController@" Toggled="OptionChanged"/></Grid>
</StackPanel>
    <InfoBar Grid.Column="1" VerticalAlignment="Top" x:Name="HideInfo" IsClosable="False" Severity="Informational" Message="@WinUI.HidHideSettingsRequirement@"><InfoBar.ActionButton><Button x:Name="OpenSettingsAction" Content="@WinUI.OpenSettings@" Click="OpenSettingsClicked"/></InfoBar.ActionButton></InfoBar>
   </Grid></Border>
 </StackPanel></ScrollViewer>
</Page>
